<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>AlwaysCheckLatestVersion</key>
			<true/>
			<key>EnforceAppSignInToJoin</key>
			<true/>
			<key>EnforceAppSignInToJoinForWebinar</key>
			<true/>
			<key>EnforceSignInToJoin</key>
			<true/>
			<key>EnforceSignInToJoinForWebinar</key>
			<true/>
			<!-- <key>ForceSSOURL</key> not enforced as some users require using other orgs Zoom accounts -->
			<!-- <string>netguru.zoom.us</string> -->
			<key>EnableAppleLogin</key>
			<false/>
			<key>NoFacebook</key>
			<true/>
			<key>NoGoogle</key>
			<false/>
			<key>DisableLoginWithEmail</key>
			<true/>
			<key>DisableAutoLaunchSSO</key>
			<true/>
			<key>PayloadDisplayName</key>
			<string>Zoom</string>
			<key>PayloadIdentifier</key>
			<string>com.github.erikberglund.ProfileCreator.AC21F117-8FBE-4EE5-B383-666773DC164B.us.zoom.config.C6B7A1E3-A3AD-4985-B889-4E98E78FCCDE</string>
			<key>PayloadOrganization</key>
			<string></string>
			<key>PayloadType</key>
			<string>us.zoom.config</string>
			<key>PayloadUUID</key>
			<string>C6B7A1E3-A3AD-4985-B889-4E98E78FCCDE</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ZAutoSSOLogin</key>
			<true/>
			<key>ZAutoUpdate</key>
			<true/>
			<key>ZSSOHost</key>
			<string>netguru</string>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>Zoom Netguru config</string>
