					"raw": "{\n  \"schemas\": [\n    \"urn:ietf:params:scim:api:messages:2.0:PatchOp\"\n  ],\n  \"Operations\": [\n    {\n      \"op\": \"Replace\",\n      \"value\": {\"active\":false}\n    }\n  ]\n}"
				},
				"url": {
					"raw": "https://netguru.invisionapp.com/scim/v2/Users/<put_user_id_here>",
					"protocol": "https",
					"host": [
						"netguru",
						"invisionapp",
						"com"
					],
					"path": [
						"scim",
						"v2",
